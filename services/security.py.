import requests

def check_token_security(token_address):
    url = (
        "https://api.dexscreener.com/"
        f"token-pairs/v1/solana/{token_address}"
    )

    response = requests.get(url, timeout=15)
    response.raise_for_status()

    pairs = response.json()

    if not isinstance(pairs, list) or not pairs:
        return {
            "available": False,
            "message": "Рыночные данные не найдены"
        }

    pairs.sort(
        key=lambda p: float(
            p.get("liquidity", {}).get("usd") or 0
        ),
        reverse=True
    )

    pair = pairs[0]
    liquidity = float(
        pair.get("liquidity", {}).get("usd") or 0
    )

    return {
        "available": True,
        "liquidity_usd": liquidity,
        "pair_created_at": pair.get("pairCreatedAt"),
        "dex_id": pair.get("dexId"),
        "market_url": pair.get("url"),
        "warning": (
            "Данных недостаточно для полной проверки безопасности"
        )
    }